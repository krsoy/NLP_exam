        "Display the original transcript text and the extracted topics for a small sample of companies from `df_topics`, allowing for a side-by-side comparison to assess the LLM's extraction quality.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "a375817e"
      },
      "source": [
        "**Reasoning**:\n",
        "To display the original transcript text and the extracted topics for a small sample, I will first select a few entries from `df_topics`, then retrieve their corresponding full transcripts from `df_2024` and print them along with the extracted topics.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "bec43e7d"
      },
      "source": [
        "print(\"\\n--- Sample for Manual Review ---\")\n",
        "sample_for_review_size = 3\n",
        "review_sample = df_topics.sample(n=min(sample_for_review_size, len(df_topics)), random_state=1)\n",
        "\n",
        "for idx, row in review_sample.iterrows():\n",
        "    symbol = row['symbol']\n",
        "    quarter = row['quarter']\n",
        "    extracted_topics = row['topics']\n",
        "\n",
        "    # Find the original transcript in df_2024\n",
        "    original_transcript_row = df_2024[\n",
        "        (df_2024['symbol'] == symbol) & (df_2024['quarter'] == quarter)\n",
        "    ].iloc[0]\n",
        "\n",
        "    original_text = (\n",
        "        original_transcript_row.get(\"transcript\") or\n",
        "        original_transcript_row.get(\"text\") or\n",
        "        original_transcript_row.get(\"content\") or\n",
        "        \"[Transcript not found]\"\n",
        "    )\n",
        "\n",
        "    print(f\"\\nCompany: {symbol} (Q{quarter})\")\n",
        "    print(\"--- Original Transcript (First 1500 chars) ---\")\n",
        "    print(original_text[:1500] + \"...\")\n",
        "    print(\"\\n--- Extracted Topics ---\")\n",
        "    for topic in extracted_topics:\n",
        "        print(f\"- {topic}\")\n",
        "    print(\"\\n\" + \"=\"*80)\n"
      ],
      "execution_count": null,
      "outputs": []
    },
