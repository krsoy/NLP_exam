      "source": [
        "from pydantic import BaseModel, Field\n",
        "from typing import List\n",
        "\n",
        "class RiskExtraction(BaseModel):\n",
        "    company_name: str = Field(..., description=\"Exact company name. Must be 'Tesla' if present.\")\n",
        "    discusses_risk: bool = Field(..., description=\"Does the transcript discuss any risk?\")\n",
        "    risk_types: List[str] = Field(\n",
        "        default=[],\n",
        "        description=\"List of risk types, e.g. 'supply chain', 'regulatory', 'competition'.\"\n",
        "    )"
      ]
    },
